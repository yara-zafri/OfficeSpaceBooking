<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="22dp" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OFFICE SPACE BOOKING" android:textColor="#2563EB" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="9dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Employee Requests" android:textColor="#0F172A" android:textSize="25sp" android:textStyle="bold" android:layout_marginBottom="5dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Review submitted booking and cancellation requests" android:textColor="#64748B" android:textSize="14sp" android:textStyle="normal" android:layout_marginBottom="25dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Request #101  •  Booking
Meeting Room 1, 12 Nov, 10:00
Status: Pending" android:textColor="#1D4ED8" android:textSize="15sp" android:gravity="center_vertical" android:padding="16dp" android:minHeight="56dp" android:background="@drawable/ui_card" android:layout_marginBottom="12dp"/>
<Button android:layout_width="match_parent" android:layout_height="52dp" android:text="Approve Request" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#2563EB" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
<Button android:layout_width="match_parent" android:layout_height="52dp" android:text="Reject Request" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#2563EB" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Request #102  •  Cancellation
Seminar Room 2, 16 Nov
Status: Pending" android:textColor="#1D4ED8" android:textSize="15sp" android:gravity="center_vertical" android:padding="16dp" android:minHeight="56dp" android:background="@drawable/ui_card" android:layout_marginBottom="12dp"/>
<Button android:layout_width="match_parent" android:layout_height="52dp" android:text="Review Cancellation" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#2563EB" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
    </LinearLayout>
</ScrollView>
