<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="22dp" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OFFICE SPACE BOOKING" android:textColor="#2563EB" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="9dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My Bookings" android:textColor="#0F172A" android:textSize="25sp" android:textStyle="bold" android:layout_marginBottom="5dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Track or cancel your reservations" android:textColor="#64748B" android:textSize="14sp" android:textStyle="normal" android:layout_marginBottom="25dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Meeting Room 1
12 Nov, 10:00–11:00
Status: Pending" android:textColor="#1D4ED8" android:textSize="15sp" android:gravity="center_vertical" android:padding="16dp" android:minHeight="56dp" android:background="@drawable/ui_card" android:layout_marginBottom="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seminar Room 2
16 Nov, 14:00–15:00
Status: Confirmed" android:textColor="#1D4ED8" android:textSize="15sp" android:gravity="center_vertical" android:padding="16dp" android:minHeight="56dp" android:background="@drawable/ui_card" android:layout_marginBottom="12dp"/>
<Button android:layout_width="match_parent" android:layout_height="52dp" android:text="Cancel Selected Booking" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#2563EB" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cancellation requires confirmation in a functional version." android:textColor="#64748B" android:textSize="12sp" android:textStyle="normal" android:layout_marginBottom="8dp"/>
    </LinearLayout>
</ScrollView>
