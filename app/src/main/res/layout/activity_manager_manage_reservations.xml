<Button android:layout_width="match_parent" android:layout_height="52dp" android:text="Cancel Selected Reservation" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#2563EB" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
